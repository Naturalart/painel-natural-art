{%- comment -%}
  Natural Art: oferta de kit na página da bermuda avulsa ("Leve 2 por R$ X").
  Mapa: handle do produto avulso -> kits candidatos "handle;qtd;cores", separados por "|".
  Usa o primeiro kit publicado e com estoque; se nenhum estiver no ar, o bloco não aparece.
{%- endcomment -%}
{%- liquid
  assign k3_flat = 'compre-1-leve-3-bermudas-passeio-walk-flat-20-preto-verde-e-cinza;3;Preto, Verde e Cinza'
  assign k2_flat = 'kit-2-bermudas-passeio-walk-flat-20-preto-e-verde;2;Preto e Verde'
  assign k2_ibiza = 'compre-1-leve-2-bermudas-passeio-walk-ibiza-20-marinho-e-verde;2;Marinho e Verde'
  assign k2_pocket = 'kit-2-bermudas-passeio-walk-pocket-20-bege-e-preto;2;Bege e Preto'
  assign k2_hib = 'kit-2-bermudas-hibridas-20-clear-vermelho-e-neo-blend-chumbo;2;Clear Vermelho e Neo Blend Chumbo'
  assign k2_stripe = 'kit-2-bermudas-hibridas-20-stripe-cinza-e-neo-blend-chumbo;2;Stripe Cinza e Neo Blend Chumbo'
  assign k3_hib = 'kit-3-bermudas-hibridas-20-clear-vermelho-neo-blend-chumbo-e-stripe-chumbo;3;Clear, Neo Blend e Stripe'
  assign k2_pc_cinza = 'kit-praia-e-cidade-20-walk-flat-cinza-e-hibrida-neo-blend-chumbo;2;Walk Flat Cinza e Híbrida Neo Blend'
  assign k2_deep = 'kit-2-bermudas-elastico-deep-18-preto-e-caqui;2;Preto e Caqui'
  assign k3_elastico = 'kit-3-bermudas-elastico-18-deep-preto-deep-caqui-e-degrade-logos;3;Deep Preto, Deep Caqui e Degradê'

  assign candidatos = ''
  unless product.tags contains 'sem-cupom-kit'
    case product.handle
      when 'bermuda-passeio-walk-flat-20', 'bermuda-passeio-walk-flat-20-verde-f2nrl'
        assign candidatos = k2_flat | append: '|' | append: k3_flat
      when 'bermuda-passeio-walk-flat-20-cinza'
        assign candidatos = k2_pc_cinza | append: '|' | append: k3_flat
      when 'bermuda-passeio-walk-pocket-20-bege-9bx16', 'bermuda-passeio-walk-pocket-20-preto-1e81f'
        assign candidatos = k2_pocket
      when 'bermuda-c-bolso-hibrida-clear-20-vermelho-1itws', 'bermuda-c-bolso-hybrida-neo-blend-20-chumbo-il7al'
        assign candidatos = k2_hib | append: '|' | append: k3_hib
      when 'bermuda-c-bolso-hybrida-stripes-20-14vyf'
        assign candidatos = k2_stripe
      when 'bermuda-c-bolso-hybrida-stripes-20-chumbo-1k1j6'
        assign candidatos = k3_hib
      when 'bermuda-elastico-deep-18', 'bermuda-elastico-deep-19'
        assign candidatos = k2_deep | append: '|' | append: k3_elastico
      when 'shorts-elastico-degrade-logos-18-azul'
        assign candidatos = k3_elastico
      else
        if product.handle contains 'walk-flat'
          assign candidatos = k2_flat | append: '|' | append: k3_flat
        elsif product.handle contains 'walk-ibiza'
          assign candidatos = k2_ibiza
        endif
    endcase
  endunless

  assign kit = blank
  assign lista = candidatos | split: '|'
  for c in lista
    assign partes = c | split: ';'
    assign k = all_products[partes[0]]
    if k != blank and k.available
      assign kit = k
      assign kit_qtd = partes[1] | plus: 0
      assign kit_cores = partes[2]
      break
    endif
  endfor
-%}
{%- if kit != blank and kit.available -%}
  {%- liquid
    if kit.compare_at_price > kit.price
      assign economia = kit.compare_at_price | minus: kit.price
    else
      assign unit = product.selected_or_first_available_variant.price
      assign avulsas = unit | times: kit_qtd
      assign economia = avulsas | minus: kit.price
    endif
    assign cada = kit.price | divided_by: kit_qtd
  -%}
  <a class="na-kit-oferta" href="{{ kit.url }}">
    <span class="na-kit-oferta__tag">Kit</span>
    <span class="na-kit-oferta__txt">
      <strong>Leve {{ kit_qtd }} por {{ kit.price | money }}</strong>
      <span>{{ kit_cores }} · sai {{ cada | money }} cada{% if economia > 0 %} · economize {{ economia | money }}{% endif %}</span>
    </span>
    <span class="na-kit-oferta__cta">Ver kit →</span>
  </a>
  <style>
    .na-kit-oferta{display:flex;align-items:center;gap:12px;margin:6px 0 4px;padding:12px 14px;border:1.5px solid #1a7a1a;border-radius:10px;background:#f3f7f3;color:#111;text-decoration:none;font-family:var(--font-body--family),sans-serif}
    .na-kit-oferta__tag{flex-shrink:0;background:#1a7a1a;color:#fff;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:4px 8px;border-radius:4px}
    .na-kit-oferta__txt{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
    .na-kit-oferta__txt strong{font-size:15px}
    .na-kit-oferta__txt span{font-size:12px;color:#444}
    .na-kit-oferta__cta{flex-shrink:0;font-size:13px;font-weight:700;color:#1a7a1a;white-space:nowrap}
  </style>
{%- endif -%}
