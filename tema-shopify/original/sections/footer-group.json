        "custom_liquid": "<footer class=\"na-footer\">\n<style>\n.na-footer{background:#111111;color:#fff;font-family:var(--font-body--family),sans-serif;padding:56px 0 0;}\n.na-footer__inner{max-width:1200px;margin:0 auto;padding:0 40px;}\n.na-footer__grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;align-items:start;padding-bottom:48px;border-bottom:1px solid rgba(255,255,255,.1);}\n.na-footer__brand img{height:44px;width:auto;object-fit:contain;display:block;margin-bottom:14px;filter:brightness(0) invert(1);}\n.na-footer__tagline{font-size:13px;color:rgba(255,255,255,.55);line-height:1.55;margin:0 0 20px;max-width:220px;}\n.na-footer__social{display:flex;gap:14px;align-items:center;}\n.na-footer__social a{color:rgba(255,255,255,.65);transition:color .2s;display:inline-flex;align-items:center;}\n.na-footer__social a:hover{color:#fff;}\n.na-footer__social svg{width:20px;height:20px;}\n.na-footer__menu-heading{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#fff;margin:0 0 16px;}\n.na-footer__menu-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;}\n.na-footer__menu-list a{font-size:13px;color:rgba(255,255,255,.6);text-decoration:none;transition:color .2s;line-height:1.4;}\n.na-footer__menu-list a:hover{color:#fff;}\n/* BOTTOM */\n.na-footer__bottom--desktop{display:flex;flex-direction:column;align-items:center;gap:12px;padding:24px 0 32px;text-align:center;}\n.na-footer__copyright{font-size:11px;color:rgba(255,255,255,.4);line-height:1.7;margin:0;text-align:center;}\n/* BADGES */\n.na-footer__badges{display:flex;align-items:center;justify-content:center;flex-wrap:nowrap;gap:8px;}\n.na-footer__seal-divider{width:1px;height:28px;background:rgba(255,255,255,.15);flex-shrink:0;margin:0 4px;}\n.na-footer__seal{display:inline-flex;align-items:center;flex-shrink:0;}\n.na-footer__seal img{height:28px;width:auto;object-fit:contain;display:block;}\n.na-pay{display:flex;flex-wrap:nowrap;gap:5px;align-items:center;justify-content:center;}\n.na-pay svg,.na-pay img{width:34px;height:22px;display:block;border-radius:3px;flex-shrink:0;}\n/* MOBILE */\n.na-footer__acc{display:none;}\n.na-footer__bottom--mobile{display:none;}\n@media(max-width:749px){\n  .na-footer__inner{padding:0 20px;}\n  .na-footer__grid{display:none;}\n  .na-footer__bottom--desktop{display:none;}\n  .na-footer__acc{display:block;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.1);}\n  .na-footer__acc-brand{padding:32px 0 24px;}\n  .na-footer__acc-brand img{height:38px;width:auto;filter:brightness(0) invert(1);display:block;margin-bottom:10px;}\n  .na-footer__acc-brand p{font-size:13px;color:rgba(255,255,255,.55);margin:0;}\n  .na-footer__acc-item{border-top:1px solid rgba(255,255,255,.1);}\n  .na-footer__acc-trigger{width:100%;display:flex;align-items:center;justify-content:space-between;background:none;border:none;color:#fff;font-family:inherit;font-size:14px;font-weight:600;padding:16px 0;cursor:pointer;text-align:left;}\n  .na-footer__acc-trigger svg{width:16px;height:16px;transition:transform .25s;flex-shrink:0;color:rgba(255,255,255,.5);}\n  .na-footer__acc-item.is-open .na-footer__acc-trigger svg{transform:rotate(180deg);}\n  .na-footer__acc-panel{max-height:0;overflow:hidden;transition:max-height .3s ease;}\n  .na-footer__acc-panel ul{list-style:none;margin:0;padding:0 0 16px;display:flex;flex-direction:column;gap:12px;}\n  .na-footer__acc-panel ul a{font-size:13px;color:rgba(255,255,255,.6);text-decoration:none;}\n  .na-footer__acc-social{padding:24px 0 4px;display:flex;gap:20px;align-items:center;}\n  .na-footer__acc-social a{color:rgba(255,255,255,.65);display:inline-flex;}\n  .na-footer__acc-social svg{width:22px;height:22px;}\n  .na-footer__bottom--mobile{display:flex;flex-direction:column;align-items:center;gap:12px;padding:20px 0 32px;text-align:center;}\n  /* selos menores no mobile para caber em 1 linha */\n  .na-footer__badges{flex-wrap:nowrap;gap:5px;overflo