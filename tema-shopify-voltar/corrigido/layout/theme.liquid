<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <script>
      /*
        Botão voltar (14/10): scripts de fora do tema (ex.: UTMify, apps) chamam history.pushState
        na mesma página, só trocando parâmetros (?utm_...) ou #. Cada chamada cria uma entrada no
        histórico e o cliente aperta voltar e continua na mesma página.
        Aqui, pushState para a mesma página vira replaceState (no objeto e no protótipo, para pegar
        também quem chama History.prototype.pushState). Precisa ficar antes de qualquer script.

        Diagnóstico: abrir qualquer página com ?debugvoltar=1 mostra no rodapé tudo o que mexe no
        histórico (pushState, replaceState, iframes, navegações). Desliga com ?debugvoltar=0.
      */
      (function () {
        var dbg = false, KEY = 'na_dbg_voltar', LOG = 'na_dbg_voltar_log';
        try {
          if (/[?&]debugvoltar=1/.test(location.search)) sessionStorage.setItem(KEY, '1');
          if (/[?&]debugvoltar=0/.test(location.search)) { sessionStorage.removeItem(KEY); sessionStorage.removeItem(LOG); }
          dbg = sessionStorage.getItem(KEY) === '1';
        } catch (e) {}
        function short(u) { try { var x = new URL(u, location.href); return (x.origin === location.origin ? '' : x.host) + x.pathname.slice(0, 40) + (x.search ? x.search.slice(0, 40) : '') + x.hash.slice(0, 20); } catch (e) { return String(u).slice(0, 60); } }
        function who() { var st = (new Error().stack || '').split('\n'); for (var i = 2; i < st.length; i++) { var m = st[i].match(/https?:\/\/[^\s)]+/); if (m && m[0].indexOf('na-dbg') < 0) return short(m[0].replace(/:\d+:\d+$/, '')); } return '?'; }
        function log(msg) {
          if (!dbg) return;
          var line = new Date().toTimeString().slice(3, 8) + ' [' + history.length + '] ' + msg;
          try { var arr = JSON.parse(sessionStorage.getItem(LOG) || '[]'); arr.push(line); sessionStorage.setItem(LOG, JSON.stringify(arr.slice(-40))); } catch (e) {}
          var box = document.getElementById('na-dbg-voltar'); if (box) box.textContent = line + '\n' + box.textContent;
        }
        try {
          var H = window.History && History.prototype, push = H.pushState, repl = H.replaceState;
          H.pushState = function (state, title, url) {
            var same = false;
            try { if (url != null) { var n = new URL(url, location.href); same = n.origin === location.origin && n.pathname === location.pathname; } } catch (e) {}
            log((same ? 'push->replace ' : 'PUSH ') + short(url) + ' por ' + who());
            return same ? repl.apply(this, arguments) : push.apply(this, arguments);
          };
          if (dbg) H.replaceState = function (state, title, url) { log('replace ' + short(url) + ' por ' + who()); return repl.apply(this, arguments); };
          if (window.history.pushState !== H.pushState) window.history.pushState = H.pushState;
        } catch (e) {}
        if (!dbg) return;
        log('CARREGOU ' + short(location.href) + ' (veio de ' + (document.referrer ? short(document.referrer) : 'nada') + ')');
        window.addEventListener('popstate', function () { log('popstate ' + short(location.href)); });
        window.addEventListener('hashchange', function () { log('hashchange ' + location.hash); });
        window.addEventListener('pageshow', function (e) { if (e.persisted) log('voltou do cache ' + short(location.href)); });
        if (window.navigation && navigation.addEventListener) navigation.addEventListener('navigate', function (e) { log('navigate ' + e.navigationType + ' ' + short(e.destination.url)); });
        var last = history.length;
        setInterval(function () { if (history.length !== last) { log('historico ' + last + ' -> ' + history.length); last = history.length; } }, 300);
        new MutationObserver(function (ms) { ms.forEach(function (m) { m.addedNodes.forEach(function (n) { if (n.tagName === 'IFRAME') log('IFRAME ' + short(n.src || n.getAttribute('src') || 'sem src') + ' ' + (n.id || n.name || '')); }); }); }).observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', function () {
          var box = document.createElement('pre');
          box.id = 'na-dbg-voltar';
          box.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:2147483647;max-height:38vh;overflow:auto;margin:0;padding:6px 8px;background:rgba(0,0,0,.85);color:#7CFC00;font:10px/1.35 monospace;white-space:pre-wrap;pointer-events:auto';
          try { box.textContent = JSON.parse(sessionStorage.getItem(LOG) || '[]').slice().reverse().join('\n'); } catch (e) {}
          document.body.appendChild(box);
        });
      })();
    </script>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <style>.cart-discount{display:none!important;}.resource-list__carousel{--peek-next-slide-size:0px;}</style>
    <!-- UTMify: captura de UTMs -->
    <script src="https://cdn.utmify.com.br/scripts/utms/latest.js" data-utmify-prevent-xcod-sck data-utmify-prevent-subids async defer></script>
    {% # theme-check-enable RemoteAsset %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  <!-- Não remova. Checkout Yampi. -->
{% capture yampi_snippet_content %}{% include 'YampiSnippet' %}{% endcapture %} {% unless yampi_snippet_content contains 'Liquid error' %} {% include 'YampiSnippet' %} {% endunless %}
<!-- Não remova. Checkout Yampi. -->
    {% render 'na-kit-overrides' %}
  </body>
</html>
