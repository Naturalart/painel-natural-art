{%- liquid
  assign default_images = "atleta-1.jpg,atleta-2.jpg,atleta-5.jpg,moletom-na-1k-logoajustado-rua.png,caarro-feed.png,rua-feed.png,atleta-3.webp,atleta-4.jpg,atleta-6.jpg" | split: ","
  assign cdn_base = "https://cdn.shopify.com/s/files/1/0961/5084/7803/files/"
-%}
{%- comment -%}
  Revisão E1 (14/10): a seção fica abaixo da dobra, então todas as fotos carregam "lazy".
  As fotos padrão saem dos Arquivos redimensionadas (400px) em vez do arquivo original (até 245 KB cada).
{%- endcomment -%}
{%- style -%}
  @keyframes na-marquee-{{ section.id }} {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  #na-proof-{{ section.id }} { background: {{ section.settings.bg_color }}; padding: 0; overflow: hidden; }
  #na-proof-{{ section.id }} .na-proof-inner { text-align: center; padding: 50px 20px 40px; }
  #na-proof-{{ section.id }} .na-proof-number { font-size: 140px; font-weight: 800; line-height: 1; background: linear-gradient(150deg, rgba(0,0,0,1) 20%, rgba(173,173,173,1) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; color: transparent; letter-spacing: -4px; }
  #na-proof-{{ section.id }} .na-proof-tagline { font-size: 20px; color: #555; margin-top: 12px; font-weight: 400; letter-spacing: 0.3px; }
  #na-proof-{{ section.id }} .na-proof-marquee { overflow: hidden; width: 100%; }
  #na-proof-{{ section.id }} .na-proof-marquee-track { display: flex; gap: 8px; width: max-content; animation: na-marquee-{{ section.id }} {{ section.settings.speed }}s linear infinite; }
  #na-proof-{{ section.id }} .na-proof-marquee-track:hover { animation-play-state: paused; }
  #na-proof-{{ section.id }} .na-proof-marquee-item { flex-shrink: 0; width: 200px; height: 267px; border-radius: 12px; overflow: hidden; }
  #na-proof-{{ section.id }} .na-proof-marquee-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #na-proof-{{ section.id }} .na-brand-copy { text-align: center; padding: 32px 24px 40px; }
  #na-proof-{{ section.id }} .na-brand-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #bbb; margin-bottom: 10px; }
  #na-proof-{{ section.id }} .na-brand-headline { font-size: 26px; font-weight: 700; line-height: 1.2; color: #111; letter-spacing: -0.5px; margin-bottom: 12px; }
  #na-proof-{{ section.id }} .na-brand-sub { font-size: 14px; color: #777; line-height: 1.65; max-width: 480px; margin: 0 auto; font-weight: 400; }
  @media (max-width: 768px) {
    #na-proof-{{ section.id }} .na-proof-number { font-size: 72px; letter-spacing: -2px; }
    #na-proof-{{ section.id }} .na-proof-tagline { font-size: 17px; }
    #na-proof-{{ section.id }} .na-proof-marquee-item { width: 150px; height: 200px; }
    #na-proof-{{ section.id }} .na-brand-headline { font-size: 20px; }
    #na-proof-{{ section.id }} .na-brand-copy { padding: 24px 24px 32px; }
  }
{%- endstyle -%}

<div id="na-proof-{{ section.id }}">
  <div class="na-proof-inner">
    <div class="na-proof-number">{{ section.settings.prefix }}<span class="na-countup" data-target="{{ section.settings.count_target }}">0</span>{{ section.settings.suffix }}</div>
    <div class="na-proof-tagline">{{ section.settings.tagline }}</div>
  </div>

  <div class="na-proof-marquee">
    <div class="na-proof-marquee-track">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <div class="na-proof-marquee-item" {{ block.shopify_attributes }}><img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy" decoding="async" width="200" height="267"></div>
          {%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <div class="na-proof-marquee-item"><img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy" decoding="async" width="200" height="267"></div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- capture na_proof_imgs -%}
          {%- for name in default_images -%}
            {%- assign na_file = images[name] -%}
            {%- if na_file != blank -%}
              <div class="na-proof-marquee-item"><img src="{{ na_file | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy" decoding="async" width="200" height="267"></div>
            {%- else -%}
              <div class="na-proof-marquee-item"><img src="{{ cdn_base }}{{ name }}" alt="{{ shop.name }}" loading="lazy" decoding="async" width="200" height="267"></div>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {{ na_proof_imgs }}{{ na_proof_imgs }}
      {%- endif -%}
    </div>
  </div>

  <div class="na-brand-copy">
    {%- if section.settings.eyebrow != blank -%}<p class="na-brand-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.headline != blank -%}<h2 class="na-brand-headline">{{ section.settings.headline }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="na-brand-sub">{{ section.settings.subtext }}</p>{%- endif -%}
  </div>
</div>

<script>
(function() {
  var root = document.getElementById('na-proof-{{ section.id }}');
  if (!root) return;
  var countups = root.querySelectorAll('.na-countup');
  if (!countups.length) return;
  if (typeof IntersectionObserver === 'undefined') {
    countups.forEach(function(el){ el.textContent = el.getAttribute('data-target'); });
    return;
  }
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      var el = entry.target;
      if (el.getAttribute('data-animated')) return;
      el.setAttribute('data-animated', '1');
      obs.unobserve(el);
      var target = parseInt(el.getAttribute('data-target'), 10);
      var start = null, duration = 2000;
      function tick(now) {
        if (!start) start = now;
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target);
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  }, { threshold: 0.2, rootMargin: '0px 0px -80px 0px' });
  countups.forEach(function(el){ obs.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Prova social / marquee",
  "tag": "section",
  "class": "section-na-social-proof",
  "settings": [
    { "type": "header", "content": "Numero" },
    { "type": "text", "id": "prefix", "label": "Prefixo", "default": "+" },
    { "type": "number", "id": "count_target", "label": "Numero que anima", "default": 250 },
    { "type": "text", "id": "suffix", "label": "Sufixo (texto fixo)", "default": ".000" },
    { "type": "text", "id": "tagline", "label": "Frase", "default": "Vestindo Natural Art pelo mundo." },
    { "type": "header", "content": "Marquee" },
    { "type": "range", "id": "speed", "label": "Duracao da volta (s)", "min": 10, "max": 60, "step": 1, "default": 28 },
    { "type": "header", "content": "Texto institucional" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Natural Art · Since 1971" },
    { "type": "text", "id": "headline", "label": "Titulo", "default": "Da praia a cidade." },
    { "type": "textarea", "id": "subtext", "label": "Subtexto", "default": "Mais de 50 anos entregando produtos que unem conforto e estilo - dos primeiros surfboards as ruas da cidade." },
    { "type": "header", "content": "Aparencia" },
    { "type": "color", "id": "bg_color", "label": "Cor de fundo", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "photo", "name": "Foto", "settings": [ { "type": "image_picker", "id": "image", "label": "Imagem" } ] }
  ],
  "presets": [ { "name": "Prova social / marquee" } ]
}
{% endschema %}
